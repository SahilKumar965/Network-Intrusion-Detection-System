# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://nids:CHANGE_ME@localhost:5432/nids
# Optional: lets pytest also run the API and database tests against PostgreSQL (data in it is wiped).
TEST_DATABASE_URL=postgresql+psycopg://nids:CHANGE_ME@localhost:5432/nids_test
MAX_UPLOAD_MB=50
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173
